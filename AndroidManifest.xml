<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <package android:name="com.blackberry.hub" />
        <package android:name="com.blackberry.calendar" />
        <package android:name="com.blackberry.notes" />
        <package android:name="com.blackberry.tasks" />
        <package android:name="com.blackberry.contacts" />
        <package android:name="com.blackberry.infrastructure" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="BB Experience"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- Main Home Launcher Activity -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Dedicated App Drawer Icon Alias so user can always open BB Settings & Companion Installer -->
        <activity-alias
            android:name=".BBSettingsLauncherAlias"
            android:targetActivity=".MainActivity"
            android:label="BB Experience Setup"
            android:icon="@android:drawable/sym_def_app_icon"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- System-wide BlackBerry KEY2 Keyboard Service with Flow Glide Typing -->
        <service
            android:name=".BBKeyboardService"
            android:label="BB KEY2 Keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>
</manifest>
